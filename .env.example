# AI 夸夸/吐槽墙（默认：智谱 GLM-4-Flash 免费模型，OpenAI 兼容）
AI_API_KEY=
# 智谱 BigModel OpenAI 兼容地址
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=GLM-4-Flash-250414
# 可选：卡片 JSON 存储路径（默认项目下 data/ai-wall.json）
